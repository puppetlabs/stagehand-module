<%- | | -%>
# Managed by Puppet (stagehand::webhook). Local edits are overwritten on the next agent run.
# Overrides for the webhook-go fork's systemd unit. Guide: docs/stagehand-webhook.md
[Service]
# Stopping: the fork handles SIGTERM itself. It cancels the running deploy,
# kills the engine's whole process group (r10k or g10k and their git
# children), marks queued jobs failed and writes the job records, waiting up
# to 30s. Upstream's unit has KillMode=process, so anything left in the unit
# after the main process exits is never signalled and is orphaned.
# KillMode=mixed sends SIGTERM to the main process only, so the fork can do
# the above, then SIGKILL to everything still in the unit's cgroup once
# TimeoutStopSec expires. 60s leaves room for the fork's own 30s wait.
KillMode=mixed
TimeoutStopSec=60
# Reloading: upstream's ExecReload sends SIGHUP to $PID, which systemd never
# defines, so a reload does nothing. A SIGHUP that did arrive would be worse:
# Go's default action ends the process at once, skipping the graceful stop
# above, and the next start fails the running job as interrupted. The empty
# line below clears ExecReload, so `systemctl reload webhook-go` is refused
# and a reload never sends SIGHUP. Config changes need a restart; Puppet
# restarts the service whenever webhook.yml changes.
ExecReload=
