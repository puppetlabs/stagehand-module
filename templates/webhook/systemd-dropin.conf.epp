<%- |
  String[1]        $run_as,
  String[1]        $server_key,
  Array[String[1], 1] $read_write_paths,
| -%>
# Managed by Puppet (stagehand::webhook). Local edits are overwritten on the next agent run.
# Node-specific overrides for the Stagehand deploy agent's packaged systemd unit.
# Guide: docs/stagehand-webhook.md
[Service]
# The user the agent runs as. It is never root; the agent refuses to start as root.
User=<%= $run_as %>
# This node's Puppet private key, copied by systemd into a directory only the service
# user can read (/run/credentials/stagehand-deploy-agent.service/server.key). Puppet's own
# ssl directory is not touched. Needs systemd 247 or later. The key is read once at
# service start, so a renewed certificate needs a service restart.
LoadCredential=server.key:<%= $server_key.regsubst('%', '%%', 'G') %>
# The unit makes the file system read-only except for the paths listed. The empty line
# clears the packaged defaults, the next line sets the real ones. Each directory must
# exist before the service starts (the class creates them).
ReadWritePaths=
ReadWritePaths=<%= $read_write_paths.map |$path| { $path.regsubst('%', '%%', 'G') }.join(' ') %>
