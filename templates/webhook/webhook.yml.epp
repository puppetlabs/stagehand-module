<%- |
  Integer      $port,
  String[1]    $certificate,
  String[1]    $key,
  String[1]    $client_ca,
  String[1]    $crl,
  Array[String[1], 1] $allowed_certnames,
  Array[String[1]]    $allowed_fingerprints,
  String[1]    $command_path,
  String[1]    $config_path,
  Boolean      $use_g10k_commands,
  String[1]    $basedir,
  String[1]    $deploy_timeout,
  String[1]    $state_dir,
  Integer[1]   $max_jobs,
| -%>
# Managed by Puppet (stagehand::webhook). Local edits are overwritten on the next agent run.
# Stagehand fork of webhook-go: mTLS deploy API for the Advanced Code Manager pack.
# Guide: https://github.com/puppet-stagehand/stagehand-module/blob/main/docs/stagehand-webhook.md
---
server:
  port: <%= $port %>
  tls:
    enabled: true
    # Setting client_ca switches the fork to mTLS-only mode; it then refuses to
    # start without a server certificate and key and a non-empty allow-list.
    # This primary's own Puppet certificate and key are the server identity.
    certificate: '<%= $certificate.regsubst("'", "''", 'G') %>'
    key: '<%= $key.regsubst("'", "''", 'G') %>'
    # Only clients holding a certificate signed by this estate's CA may connect...
    client_ca: '<%= $client_ca.regsubst("'", "''", 'G') %>'
    # ...that has not been revoked (puppetserver ca revoke)...
    crl: '<%= $crl.regsubst("'", "''", 'G') %>'
    # ...and whose certname is on this list.
    allowed_certnames:
<%- $allowed_certnames.each |$certname| { -%>
      - '<%= $certname.regsubst("'", "''", 'G') %>'
<%- } -%>
    # Optional extra pin: SHA-256 fingerprints of the exact client certificates allowed.
<%- if $allowed_fingerprints.empty { -%>
    allowed_fingerprints: []
<%- } else { -%>
    allowed_fingerprints:
<%-   $allowed_fingerprints.each |$fingerprint| { -%>
      - '<%= $fingerprint %>'
<%-   } -%>
<%- } -%>
r10k:
  command_path: '<%= $command_path.regsubst("'", "''", 'G') %>'
  config_path: '<%= $config_path.regsubst("'", "''", 'G') %>'
  use_g10k_commands: <%= $use_g10k_commands %>
deploys:
  basedir: '<%= $basedir.regsubst("'", "''", 'G') %>'
  # Job records and the cross-process deploy lock live here (0700, root).
  state_dir: '<%= $state_dir.regsubst("'", "''", 'G') %>'
  timeout: '<%= $deploy_timeout %>'
  # Bytes of engine output kept per environment (the tail).
  output_limit: 262144
  # Job records kept; the oldest finished ones beyond this are deleted.
  max_jobs: <%= $max_jobs %>
